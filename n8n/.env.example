# n8n container env, copied to n8n/.env (gitignored). `npm run setup:secrets` generates it.
# Each secret: 32 random bytes as hex, e.g. `openssl rand -hex 32`.
N8N_ENCRYPTION_KEY=replace_me
# Same values as on the Convex deployment.
LENDLOOP_WEBHOOK_SECRET=replace_me
LENDLOOP_CONVEX_API_SECRET=replace_me
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
